<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<!-- Suppress vulnerability warning for OpenTelemetry.Api transitive dependency from Marten -->
	<NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Ardalis.Result" Version="10.1.0" />
	<PackageReference Include="Ardalis.Result.FluentValidation" Version="10.1.0" />
	<PackageReference Include="Marten" Version="8.0.0-alpha-3" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>

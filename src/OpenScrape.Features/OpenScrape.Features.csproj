<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress vulnerability warning for OpenTelemetry.Api transitive dependency from Marten -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="10.1.0" />
    <PackageReference Include="Marten" Version="8.24.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenScrape.Domain\OpenScrape.Domain.csproj" />
  </ItemGroup>

</Project>

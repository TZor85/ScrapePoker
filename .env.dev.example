# Secretos de desarrollo. Copia este archivo a .env.dev (ignorado por git).
# Formato: NOMBRE=valor, una por linea. Estas variables pisan a los appsettings.

# Neon (Postgres remoto). Usa el host del pooler y el usuario de la base.
ConnectionStrings__DefaultConnection=Host=ep-xxxx-pooler.eu-west-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=CAMBIA_ESTO;SSL Mode=Require;Channel Binding=Require;

# API: firma los tokens de licencia. Cambiarlo invalida los tokens ya emitidos.
Jwt__SigningKey=CAMBIA_ESTO_por_64_caracteres_aleatorios_0000000000000000000000000000
License__Pepper=CAMBIA_ESTO_por_un_secreto_largo

# Cliente: cifra el token guardado en disco. Cambiarlo obliga a reactivar la licencia.
# 32 caracteres aleatorios: sin esto el cliente no puede cifrar la licencia
Encrypter__Key=CAMBIAR

# Puerto donde escucha la API (launchSettings usa 5015 en el perfil http).
Api__BaseUrl=http://localhost:5015
